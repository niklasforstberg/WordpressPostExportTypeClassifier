# Cloudflare Tunnel terminerar TLS, så Caddy ska svara på http:// — inget cert här.
# Autentiseringen ligger i Cloudflare Access på hostnamnet, inte i Caddy.
http://posts.forstberg.net {
	# Kör Caddy på värden: containern lyssnar på 127.0.0.1:8080.
	reverse_proxy 127.0.0.1:8080

	# Kör Caddy i en container i stället: lägg tagger i samma docker-nätverk
	# och byt raden ovan mot containernamnet.
	# reverse_proxy wp-tagger:8080
}
